# Base URL of the FastAPI backend (no trailing slash).
# Copy this file to .env (and .env.production, etc.) and adjust as needed.
VITE_API_BASE_URL=http://localhost:8000

# Customer login. false (default) = no login at all: cart, wishlist and enquiries
# work directly for every visitor. true = login area shown and required.
# Restart `npm run dev` (or rebuild) after changing this.
VITE_LOGIN_ENABLED=false

# Google login. The PUBLIC OAuth client ID (Google Cloud Console -> APIs & Services
# -> Credentials -> OAuth client ID, type "Web application"); must equal the
# backend's GOOGLE_CLIENT_ID. Leave empty to keep Google login switched off. Add
# your site origin(s) (e.g. http://localhost:5173) under "Authorized JavaScript
# origins". The client SECRET belongs only in the backend environment.
VITE_GOOGLE_CLIENT_ID=
